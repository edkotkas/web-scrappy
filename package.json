{
  "name": "web-scrappy",
  "version": "0.1.0",
  "type": "module",
  "description": "Yet another web scraper.",
  "main": "dist/main.js",
  "files": [
    "dist/**/**",
    "!**/*.spec.*",
    "!**/*.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "scrappy": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "prebuild": "del-cli dist/",
    "build": "tsc --build tsconfig.build.json",
    "test": "tsx --tsconfig tsconfig.test.json test.ts",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "c8 --all npm run test",
    "test:mutation": "stryker run",
    "lint": "eslint .",
    "format": "prettier --config .prettierrc --ignore-unknown --write"
  },
  "author": "Eduard Kotkas",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edkotkas/web-scrappy.git"
  },
  "bugs": {
    "url": "https://github.com/edkotkas/web-scrappy/issues"
  },
  "homepage": "https://github.com/edkotkas/web-scrappy#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jasmine-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/eslint__js": "^8.42.3",
    "@types/jasmine": "^5.1.5",
    "@types/node": "^22.10.7",
    "c8": "^10.1.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "http-request-mock": "^2.0.2",
    "jasmine": "^5.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "puppeteer": "^24.1.0"
  }
}
