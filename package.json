{
  "name": "ayumi",
  "version": "0.1.0",
  "description": "Yet another web scraper.",
  "type": "module",
  "main": "dist/public.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "prebuild": "node ./node_modules/del-cli/cli.js dist/",
    "build": "tsc --build tsconfig.build.json",
    "lint": "npx --node-options='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "sample": "tsx ./sample.ts"
  },
  "author": "Eduard Kotkas",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edkotkas/ayumi.git"
  },
  "bugs": {
    "url": "https://github.com/edkotkas/ayumi/issues"
  },
  "homepage": "https://github.com/edkotkas/ayumi#readme",
  "dependencies": {
    "@ghostery/adblocker-puppeteer": "^2.14.1",
    "patchright": "^1.57.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@types/node": "^25.2.3",
    "del-cli": "^7.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}
